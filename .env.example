# .env.example — repoda turadigan YAGONA env fayl (L1 · MLab).
# Bu yerda faqat kalit NOMLARI va soxta (dev/test) qiymatlar turadi.
# Haqiqiy qiymatlar faqat: parol menejeri, GitHub Secrets va serverdagi .env (chmod 600).
# Yangi sozlama qo'shilganda Claude shu faylga va docs/SECURITY.md jadvaliga qo'shadi.

# --- Ilova ---
# development | test | production
APP_ENV=development
DJANGO_SETTINGS_MODULE=config.settings.dev
# Faqat dev uchun soxta kalit. Prod qiymati faqat serverda.
SECRET_KEY=dev-only-change-me
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:5173
TIME_ZONE=Asia/Tashkent
# Caddy ortida: X-Forwarded-For dagi proksilar soni (prod: 1). Lokalda 0.
TRUSTED_PROXY_COUNT=0
# Ro'yxatdan o'tish cheklovi, IP bo'yicha (kompyuter xonasi bitta NAT ortida).
AUTH_REGISTER_RATE=60/hour
# Hamma IP uchun umumiy ro'yxatdan o'tish chegarasi.
AUTH_REGISTER_GLOBAL_RATE=300/hour
# Login so'rovlari IP bo'yicha (lockout'dan tashqari).
AUTH_LOGIN_RATE=120/minute
# Hamma IP uchun umumiy login chegarasi.
AUTH_LOGIN_GLOBAL_RATE=600/minute
# Log darajasi: DEBUG | INFO | WARNING | ERROR (default INFO). Loglar stdout'ga JSON.
LOG_LEVEL=INFO
# Faqat prod: Caddy HTTPS'ni o'zi yo'naltirsa false qilish mumkin (default true)
SECURE_SSL_REDIRECT=true

# --- Ma'lumotlar bazasi va Redis (lokal, soxta parol) ---
DATABASE_URL=postgres://mlab:mlab@localhost:5432/mlab
REDIS_URL=redis://localhost:6379/0

# --- AI tutor ---
# fake | gemini. Testlar va bulut sessiyasi doim fake.
AI_PROVIDER=fake
# Prod qiymati faqat serverdagi .env da. Bu yerda bo'sh qoladi.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_DAILY_LIMIT_PER_STUDENT=30

# --- Sandbox (avtobaholovchi) ---
SANDBOX_IMAGE=mlab-sandbox:dev
SANDBOX_MAX_PARALLEL=2
SANDBOX_TIMEOUT_SECONDS=60
SANDBOX_MEMORY_MB=512

# --- Akademik halollik ---
PASTE_LIMIT_CHARS=200

# --- Sertifikat tekshirish sahifasi uchun ochiq manzil ---
PUBLIC_BASE_URL=http://localhost:5173
