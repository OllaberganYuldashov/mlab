{
  "name": "mlab-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "predev": "node scripts/fetch-pyodide.mjs",
    "dev": "vite",
