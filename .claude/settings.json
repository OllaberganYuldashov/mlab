{
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)",
      "Read(**/secrets/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Edit(!.env.example)",
      "Bash(git push origin main)",
      "Bash(git push origin main *)",
      "Bash(git push origin HEAD:main *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(gh api *merge*)",
      "Edit(.claude/settings.json)",
      "Edit(scripts/merge-if-green.sh)",
      "Edit(.github/workflows/merge-gate.yml)",
      "Edit(.github/workflows/main-guard.yml)",
      "Edit(.github/workflows/known-good.yml)",
      "Edit(.github/workflows/weekly-backup.yml)",
      "Edit(.github/workflows/secret-scan.yml)",
      "Bash(gh pr merge*)",
      "Bash(git push origin --delete main*)"
    ]
  }
}
